[Unit]
Description=Initial student password setup
After=systemd-user-sessions.service
Before=lightdm.service
ConditionPathExists=/var/lib/linux-flashcard/desktop-ready
ConditionPathExists=!/var/lib/linux-flashcard/password-ready
ConditionPathExists=!/sys/firmware/qemu_fw_cfg/by_name/opt/pf.factory/raw

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pf-first-password
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
